{
    "name": "shippercli/contracts",
    "description": "Contracts and interfaces for Shipper CLI providers",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "ShipperCli\\Contracts\\": "src/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.8"
    },
    "scripts": {
        "test": "php vendor/bin/pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
